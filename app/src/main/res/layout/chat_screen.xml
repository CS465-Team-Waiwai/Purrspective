<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    android:padding="8dp">

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/backButton"
        android:text="Back"
        android:backgroundTint="@color/orange">
    </Button>


    <!-- Scrollable Chat Area -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">



        </LinearLayout>
    </ScrollView>

    <!-- Message Input Bar -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@color/white"
        android:elevation="4dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:padding="10dp"
            android:background="@android:color/transparent"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Sticker Button -->
        <ImageButton
            android:id="@+id/stickerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open sticker pack"
            android:scaleType="fitCenter"
            android:src="@drawable/sticker_button"
            tools:visibility="visible" />

        <!-- Send Button (which is hidden until a sticker is selected -->

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send message"
            android:src="@android:drawable/ic_menu_send"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Sticker Pack Section (Hidden by default) this needs to have horizontally scrollable view because it was cutting stickers otherwise-->
    <HorizontalScrollView
        android:id="@+id/stickerPack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:padding="8dp"
        android:visibility="gone"
        android:scrollbars="none"
        tools:visibility="gone">
    <LinearLayout
        android:id="@+id/stickerRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Very simple button, no graphic design here, need to be refactored to look better -->
        <Button
            android:id="@+id/aiButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="6dp"
            android:text="AI" />

        <ImageView
            android:id="@+id/sticker1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Happy Sticker"
            android:padding="6dp"
            android:src="@drawable/orange_happy" />

        <ImageView
            android:id="@+id/sticker2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Sad Sticker"
            android:padding="6dp"
            android:src="@drawable/orange_sad" />

        <ImageView
            android:id="@+id/sticker3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Angry Sticker"
            android:padding="6dp"
            android:src="@drawable/orange_angry" />

        <ImageView
            android:id="@+id/sticker3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Surprised Sticker"
            android:padding="6dp"
            android:src="@drawable/orange_surprised" />

        <ImageView
            android:id="@+id/sticker3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Working Sticker"
            android:padding="6dp"
            android:src="@drawable/orange_working" />

        <ImageView
            android:id="@+id/sticker3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Sleepy Sticker"
            android:padding="6dp"
            android:src="@drawable/orange_sleepy" />
    </LinearLayout> </HorizontalScrollView>
</LinearLayout>
